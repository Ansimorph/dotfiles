{
    "layer": "top",
    "position": "top",

    "modules-left": [
        "custom/lock",
        "niri/window"
    ],

    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        "bluetooth",
        "clock#date",
        "clock#time",
    ],

    "bluetooth": {
        "format-on": "BL",
        "format-off": "No BL",
        "format-disabled": "", // an empty format will hide the module
        "format-connected": "B",
        "tooltip-format-connected": "{device_enumerate}",
        "on-click": "blueman-manager",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    },

    "battery": {
        "interval": 10,

        // Connected to AC
        "format": "{icon} {capacity}%+",

        // Not connected to AC
        "format-discharging": "{icon}  {capacity}%",
        "format-icons": [
            "", // Icon: battery-full
            "", // Icon: battery-three-quarters
            "", // Icon: battery-half
            "", // Icon: battery-quarter
            ""  // Icon: battery-empty
        ],
        "tooltip": true
    },

    "clock#time": {
        "tooltip": false
    },

    "niri/window": {
        "format": "{app_id}",
        "separate-outputs": true
    },

    "clock#date": {
      "interval": 10,
      "format": "{:%e %b %Y}",
      "tooltip": false
    },

    "network": {
        "interval": 5,
        "format-wifi": " ", // Icon: wifi
        "format-ethernet": "ethernet", // Icon: ethernet
        "format-disconnected": "⚠  Disconnected",
        "tooltip-format": "{essid} {ifname}: {ipaddr} [{signalStrength}%]"
    },

    "pulseaudio": {
        "scroll-step": 1,
        "format": "{icon}  {volume}%",
        "format-bluetooth": "{icon}  {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": ["", ""]
        },
        "on-click": "pavucontrol"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "custom/lock": {
        "format": "",
        "on-click": "swaylock",
        "tooltip": false
    },
}
