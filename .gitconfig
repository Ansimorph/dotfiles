[init]
    defaultBranch = main
[filter "media"]
	clean = git-media-clean %f
	smudge = git-media-smudge %f
[user]
	name = Björn Ganslandt
	email = hi@ganslandt.xyz
[core]
	excludesfile = /Users/bg/.gitignore_global
	autocrlf = input
	trustctime = false
	editor = hx
    pager = delta
[delta]
    syntax-theme = Catppuccin Mocha
[interactive]
    diffFilter = delta --color-only
[mergetool]
	keepBackup = true
	prompt = false
[merge]
    conflictstyle = zdiff3
[diff]
    colorMoved = default
[color]
	ui = auto
[filter "lfs"]
	clean = git lfs clean %f
	smudge = git lfs smudge %f
	required = true
[push]
	default = current
	autoSetupRemote = true
[log]
	date = short
[format]
  pretty = format:%h %Cblue%ad%Creset %ae %Cgreen%s%Creset
